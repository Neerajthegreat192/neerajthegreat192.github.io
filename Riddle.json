/* =========================================================================
   🧩 RIDDLE & GK MODULE - (शुरू)
   ========================================================================= */

let riddleData = null;
let riddleSessionUnsub = null;
let riddleTimerInterval = null;
let lastAnnouncedRiddleWinId = null;

// JSON फाइल से Riddle और GK के सवाल लोड करना
async function fetchRiddleData() {
  if (riddleData) return riddleData;
  try {
    const res = await fetch('https://neerajthegreat192.github.io/questions.json?t=' + Date.now(), { cache: 'no-store' });
    if (res.ok) {
      const data = await res.json();
      if (data && data.riddle_gk) {
        riddleData = data.riddle_gk;
        return riddleData;
      }
    }
  } catch(e) {}
  
  // यदि नेटवर्क से न मिले तो यह डिफ़ॉल्ट डेटा काम करेगा
  return {
    easy_mode: [
      { q: "Which is the National Animal of India?", opts: ["Lion", "Tiger", "Elephant", "Leopard"], ans: "Tiger" },
      { q: "ऐसी कौन सी चीज है जो पानी पीते ही मर जाती है?", opts: ["पेड़", "आग", "प्यास", "नदी"], ans: "आग" }
    ],
    hard_mode: [
      { q: "ऐसी कौन सी जगह है जहाँ समुद्र है लेकिन पानी नहीं, नदियाँ हैं लेकिन मछली नहीं?", ans: "नक्शा" },
      { q: "I speak without a mouth and hear without ears. What am I?", ans: "An Echo" }
    ]
  };
}

// 20 सेकंड का टाइमर बार
function startRiddleTimerBar(durationSec = 20) {
  stopRiddleTimerBar();
  const bar = $('riddleTimerBar');
  if (!bar) return;
  let timeLeft = durationSec;
  bar.style.transition = 'none';
  bar.style.width = '100%';
  setTimeout(() => { if (bar) bar.style.transition = 'width 1s linear'; }, 50);

  riddleTimerInterval = setInterval(() => {
    timeLeft--;
    const pct = Math.max(0, (timeLeft / durationSec) * 100);
    if (bar) bar.style.width = pct + '%';
    if (timeLeft <= 0) {
      clearInterval(riddleTimerInterval);
      riddleTimerInterval = null;
      playOopsSound();
      toast(currentLang === 'hi' ? '⏱ समय समाप्त हो गया!' : '⏱ Time up!');
      
      // समय समाप्त होने पर सही उत्तर दिखाएं और Wrong Score बढ़ाएं
      if (activeCallId) {
        const riddleRef = ref(db, `call_sessions/${activeCallId}/riddle_state`);
        get(riddleRef).then(snap => {
          const st = snap.val();
          if (st && !st.answered) {
            update(riddleRef, { 
              answered: true, 
              timedOut: true, 
              wrongScore: (st.wrongScore || 0) + 1,
              updatedAt: Date.now() 
            });
          }
        });
      }
    }
  }, 1000);
}

function stopRiddleTimerBar() {
  if (riddleTimerInterval) { clearInterval(riddleTimerInterval); riddleTimerInterval = null; }
  const bar = $('riddleTimerBar');
  if (bar) bar.style.width = '100%';
}

// नया सवाल भेजने का फंक्शन
async function sendRiddleQuestion(mode = 'easy_mode') {
  if (!activeCallId) { toast(currentLang === 'hi' ? 'कॉल कनेक्ट होने पर ही गेम खेलें' : 'Connect call to play'); return; }
  const data = await fetchRiddleData();
  const list = data[mode] || data.easy_mode;
  if (!list || list.length === 0) return;
  
  const randomQ = list[Math.floor(Math.random() * list.length)];
  const riddleRef = ref(db, `call_sessions/${activeCallId}/riddle_state`);
  
  // मौजूदा स्कोर सुरक्षित रखते हुए नया सवाल सेट करें
  get(riddleRef).then(snap => {
    const cur = snap.val() || {};
    let rScore = cur.rightScore || 0;
    let wScore = cur.wrongScore || 0;
    
    // अगर 10 पॉइंट पूरे हो गए हैं तो रीसेट करें
    if (rScore + wScore >= 10) {
      rScore = 0;
      wScore = 0;
    }

    set(riddleRef, {
      mode,
      question: randomQ.q,
      options: randomQ.opts || null,
      answer: randomQ.ans,
      answered: false,
      buzzerPressed: false,
      timedOut: false,
      rightScore: rScore,
      wrongScore: wScore,
      updatedAt: Date.now()
    });
  });
}

// रियल-टाइम लिसनर जो दोनों फोनों पर गेम को सिंक रखेगा
function initRiddleGkListener() {
  if (!activeCallId) return;
  if (riddleSessionUnsub) riddleSessionUnsub();
  
  const riddleRef = ref(db, `call_sessions/${activeCallId}/riddle_state`);
  riddleSessionUnsub = onValue(riddleRef, snap => {
    const state = snap.val();
    let box = $('kidsRiddleBox');
    if (!box) {
      ensureRiddleDOM();
      box = $('kidsRiddleBox');
    }
    if (!state || !state.question) { box.hidden = true; stopRiddleTimerBar(); return; }
    
    box.hidden = false;
    $('funModeTray').hidden = true;
    controlsBar.classList.add('fade-out');

    $('riddleQuestionText').textContent = state.question;
    $('riddleModeSelect').value = state.mode;
    
    // स्कोरबोर्ड अपडेट करें
    const rScore = state.rightScore || 0;
    const wScore = state.wrongScore || 0;
    $('riddleScoreDisplay').textContent = `✅ सही: ${rScore} | ❌ गलत: ${wScore} (Total: ${rScore + wScore}/10)`;

    const optsArea = $('riddleOptionsArea');
    const hardEvalArea = $('riddleHardEvalArea');
    optsArea.innerHTML = '';
    hardEvalArea.hidden = true;

    // अगर 10 पॉइंट पूरे हो गए हैं
    if (rScore + wScore >= 10) {
      stopRiddleTimerBar();
      optsArea.innerHTML = `<div style="text-align:center;font-size:16px;font-weight:700;color:#10b981;padding:15px;">🎉 मुकाबला समाप्त! कुल सही: ${rScore}, गलत: ${wScore}</div>`;
      return;
    }

    if (!state.answered && !state.timedOut) {
      startRiddleTimerBar(20);
    } else {
      stopRiddleTimerBar();
    }

    // Easy Mode के लिए विकल्प दिखाना
    if (state.mode === 'easy_mode' && state.options) {
      state.options.forEach(opt => {
        const btn = document.createElement('button');
        btn.className = 'quiz-opt-btn';
        btn.textContent = opt;
        
        if (state.answered) {
          if (opt === state.answer) {
            btn.style.background = '#10b981'; btn.style.color = '#fff'; btn.style.borderColor = '#10b981';
          } else if (opt === state.selectedAnswer && !state.isCorrect) {
            btn.style.background = '#ef4444'; btn.style.color = '#fff'; btn.style.borderColor = '#ef4444';
          }
          btn.disabled = true;
        }
        
        btn.onclick = (e) => {
          e.stopPropagation();
          stopRiddleTimerBar();
          const isRight = (opt === state.answer);
          if (isRight) playCheerSound(); else playOopsSound();
          
          update(riddleRef, {
            answered: true,
            selectedAnswer: opt,
            isCorrect: isRight,
            rightScore: isRight ? rScore + 1 : rScore,
            wrongScore: !isRight ? wScore + 1 : wScore,
            updatedAt: Date.now()
          });
        };
        optsArea.appendChild(btn);
      });
    } 
    // Hard Mode के लिए: बच्चा बोलकर जवाब देगा, पेरेंट सही/गलत बटन दबाएंगे
    else if (state.mode === 'hard_mode') {
      hardEvalArea.hidden = false;
      const ansLabel = $('riddleHiddenAnswer');
      
      if (state.answered) {
        ansLabel.textContent = `उत्तर: ${state.answer} (${state.isCorrect ? '✅ सही' : '❌ गलत'})`;
        ansLabel.style.color = state.isCorrect ? '#10b981' : '#ef4444';
        $('evalRightBtn').disabled = true;
        $('evalWrongBtn').disabled = true;
      } else {
        ansLabel.textContent = `[गुप्त उत्तर - पेरेंट के लिए]: ${state.answer}`;
        ansLabel.style.color = '#f59e0b';
        $('evalRightBtn').disabled = false;
        $('evalWrongBtn').disabled = false;
      }
    }

    // अगर समय समाप्त हो गया हो या जवाब दे दिया गया हो तो उत्तर दिखाएं
    if (state.answered || state.timedOut) {
      const info = document.createElement('div');
      info.style.cssText = 'margin-top:10px;font-size:14px;font-weight:700;color:#f59e0b;text-align:center;';
      info.textContent = state.timedOut ? `⏱ समय समाप्त! सही उत्तर था: ${state.answer}` : (state.isCorrect ? '🎉 सही जवाब!' : `❌ गलत! सही उत्तर था: ${state.answer}`);
      optsArea.appendChild(info);
    }
  });
}

// HTML UI DOM जनरेट करना अगर मौजूद न हो
function ensureRiddleDOM() {
  if ($('kidsRiddleBox')) return;
  const box = document.createElement('div');
  box.id = 'kidsRiddleBox';
  box.className = 'quiz-floating-box'; // क्विज़ वाले स्टाइल का उपयोग
  box.hidden = true;
  box.innerHTML = `
    <div class="quiz-header">
      <div class="quiz-title">🧩 Riddle & GK Challenge</div>
      <button id="closeRiddleBtn" class="quiz-close-btn" title="बंद करें">✕</button>
    </div>
    <div class="quiz-timer-wrap"><div id="riddleTimerBar" class="quiz-timer-bar"></div></div>
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
      <select id="riddleModeSelect" style="background:rgba(255,255,255,.1);color:#fff;border:1px solid var(--line);padding:6px;border-radius:8px;font-size:12px;">
        <option value="easy_mode">Easy Mode (6 yrs - Options)</option>
        <option value="hard_mode">Hard Mode (9 yrs - Verbal)</option>
      </select>
      <div id="riddleScoreDisplay" style="font-size:12px;font-weight:800;color:#10b981;">✅ सही: 0 | ❌ गलत: 0</div>
    </div>
    <div id="riddleQuestionText" class="quiz-question-text">सवाल लोड हो रहा है...</div>
    <div id="riddleOptionsArea" class="quiz-options-area"></div>
    
    <!-- Hard Mode Evaluation Area (Parent के लिए) -->
    <div id="riddleHardEvalArea" style="margin-top:12px;text-align:center;" hidden>
      <div id="riddleHiddenAnswer" style="font-size:13px;font-weight:700;margin-bottom:8px;"></div>
      <div style="display:flex;gap:10px;justify-content:center;">
        <button id="evalRightBtn" style="background:#10b981;color:#fff;border:0;padding:8px 16px;border-radius:8px;font-weight:700;cursor:pointer;">✅ सही (Right)</button>
        <button id="evalWrongBtn" style="background:#ef4444;color:#fff;border:0;padding:8px 16px;border-radius:8px;font-weight:700;cursor:pointer;">❌ गलत (Wrong)</button>
      </div>
    </div>

    <div style="display:flex;justify-content:space-between;margin-top:15px;">
      <button id="nextRiddleBtn" style="background:var(--c-call-tab);color:#fff;border:0;padding:8px 16px;border-radius:8px;font-weight:700;cursor:pointer;">अगला सवाल ➡️</button>
    </div>
  `;
  callScreen.appendChild(box);

  box.querySelector('#closeRiddleBtn').onclick = (e) => { e.stopPropagation(); closeRiddleGame(); };
  box.querySelector('#nextRiddleBtn').onclick = (e) => { e.stopPropagation(); sendRiddleQuestion($('riddleModeSelect').value); };
  box.querySelector('#riddleModeSelect').onchange = (e) => { e.stopPropagation(); sendRiddleQuestion(e.target.value); };
  
  box.querySelector('#evalRightBtn').onclick = (e) => {
    e.stopPropagation(); evaluateHardAnswer(true);
  };
  box.querySelector('#evalWrongBtn').onclick = (e) => {
    e.stopPropagation(); evaluateHardAnswer(false);
  };
}

// Hard mode में पेरेंट द्वारा सही/गलत दर्ज करना
async function evaluateHardAnswer(isRight) {
  if (!activeCallId) return;
  stopRiddleTimerBar();
  if (isRight) playCheerSound(); else playOopsSound();
  
  const riddleRef = ref(db, `call_sessions/${activeCallId}/riddle_state`);
  const snap = await get(riddleRef);
  const st = snap.val();
  if (!st || st.answered) return;

  const rScore = st.rightScore || 0;
  const wScore = st.wrongScore || 0;

  await update(riddleRef, {
    answered: true,
    isCorrect: isRight,
    rightScore: isRight ? rScore + 1 : rScore,
    wrongScore: !isRight ? wScore + 1 : wScore,
    updatedAt: Date.now()
  });
}

async function closeRiddleGame() {
  stopRiddleTimerBar();
  if (activeCallId) await remove(ref(db, `call_sessions/${activeCallId}/riddle_state`)).catch(()=>{});
  const box = $('kidsRiddleBox');
  if (box) box.hidden = true;
}

// फन मोड ट्रे में बटन क्लिक होने पर
$('trayBtnRiddleGk').onclick = (e) => {
  e.stopPropagation();
  $('funModeTray').hidden = true;
  if (!isCallConnected) { toast(currentLang === 'hi' ? 'कॉल कनेक्ट होने पर ही गेम शुरू करें' : 'Connect call to play'); return; }
  ensureRiddleDOM();
  sendRiddleQuestion('easy_mode');
  initRiddleGkListener();
};
